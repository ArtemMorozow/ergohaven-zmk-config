#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        ctrl+shift+down {
            bindings = <&kp LA(LG(DOWN))>;
            key-positions = <32 33>;
            layers = <0 1 2 6 7>;
        };

        shift+alt+up {
            bindings = <&kp LA(UP)>;
            key-positions = <7 8>;
            layers = <6 7>;
        };

        shift+alt+down {
            bindings = <&kp LA(DOWN)>;
            key-positions = <31 32>;
            layers = <6 7>;
        };

        ctrl+page_up {
            bindings = <&kp LG(LA(LEFT_ARROW))>;
            key-positions = <19 8>;
            layers = <6 7>;
        };

        ctrl+page_down {
            bindings = <&kp LG(LA(RIGHT_ARROW))>;
            key-positions = <21 8>;
            layers = <6 7>;
        };

        ctrl+shift+up {
            bindings = <&kp LG(LA(UP))>;
            key-positions = <8 9>;
            layers = <0 1 2 6 7>;
        };

        shift_layer {
            bindings = <&lt 5 A>;
            key-positions = <40 41>;
        };

        left_desktop {
            bindings = <&kp LC(LEFT_ARROW)>;
            key-positions = <3 14>;
        };

        right_desktop {
            bindings = <&kp LC(RIGHT_ARROW)>;
            key-positions = <3 16>;
        };

        up_desktop {
            bindings = <&kp LC(UP)>;
            key-positions = <4 3>;
        };

        down_desktop {
            bindings = <&kp LC(DOWN)>;
            key-positions = <27 28>;
        };

        to_mouse_movement {
            bindings = <&tog 9>;
            key-positions = <44 45>;
        };

        colemak_qwerty {
            bindings = <&tog 1>;
            key-positions = <36 37>;
        };
    };

    macros {
        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_COMMAND &off 2>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <50>;
        };

        cmd: cmd {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&macro_param_2to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "CMD";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        cmd_f15: cmd_f15 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL>,
                <&macro_tap>,
                <&kp F15>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "CMD_F15";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_ALT &on 2>;
            label = "LAYER_RU";
            wait-ms = <0>;
            tap-ms = <50>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_tap>,
                <&kp LS(LC(N1))>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap_time 30>,
                <&macro_tap>,
                <&kp LS(LC(N2))>;

            label = "EN";
        };

        key: key {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_tap>, <&macro_param_1to1 &kp MACRO_PLACEHOLDER>;

            label = "KEY";
        };

        multi_line_sel_up: mls {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(UP))>;
            label = "MLS";
        };

        // Hold: modifier + momentary QWERTY, so shortcuts keep QWERTY positions on Colemak
        qw_mod: qw_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo 1>,
                <&macro_param_1to1>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_1to1>,
                <&macro_release>,
                <&kp MACRO_PLACEHOLDER>,
                <&mo 1>;

            label = "QW_MOD";
            wait-ms = <0>;
            tap-ms = <0>;
        };

        multi_line_sel_down: multi_line_sel_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LG(DOWN))>;
            label = "MULTI_LINE_SEL_DOWN";
        };
    };

    behaviors {
        on: on {
            compatible = "zmk,behavior-toggle-layer";
            label = "ON";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        off: off {
            compatible = "zmk,behavior-toggle-layer";
            label = "OFF";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        ltk: ltk {
            compatible = "zmk,behavior-hold-tap";
            label = "LTK";
            bindings = <&mo>, <&key>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };

        kp_sk: kp_sk {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_SK";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <235>;
            hold-while-undecided;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            bindings = <
&kp ESC       &kp Q  &kp W   &kp F      &kp P             &kp B                                            &kp J         &kp L             &kp U           &kp Y            &kp SEMI   &trans
&kp TAB       &kp A  &kp R   &kp S      &kp T             &kp G                                            &kp M         &kp N             &kp E           &kp I            &kp O      &kp DQT
&qw_mod LEFT_ALT  &kp Z  &kp X   &kp C      &kp D             &kp V                                            &kp K         &kp H             &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp QMARK  &kp FSLH
                     &trans  &layer_ru  &qw_mod LEFT_COMMAND  &ltk 6 SPACE  &kp LEFT_SHIFT    &kp RIGHT_SHIFT  &ltk 3 SPACE  &qw_mod LEFT_CONTROL  &kp COMMA       &kp DOT
            >;
        };

        en {
            display-name = "En";
            bindings = <
&kp ESC       &kp Q  &kp W      &kp E      &kp R                             &kp T                                           &kp Y         &kp U                             &kp I           &kp O            &kp P      &kp LG(SPACE)
&kp TAB       &kp A  &kp S      &kp D      &kp F                             &kp G                                           &kp H         &kp J                             &kp K           &kp L            &kp SEMI   &kp DQT
&kp LEFT_ALT  &kp Z  &kp X      &kp C      &kp V                             &kp B                                           &kp N         &kp M                             &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp QMARK  &kp SLASH
                     &kp GRAVE  &layer_ru  &kp_sk LEFT_COMMAND LEFT_COMMAND  &ltk 6 SPACE  &kp LEFT_SHIFT    &kp LEFT_SHIFT  &ltk 3 SPACE  &kp_sk LEFT_CONTROL LEFT_CONTROL  &kp COMMA       &kp DOT
            >;
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans  &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&trans  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&trans  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I                     &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_QMARK         &kp RU_CYRILLIC_HARD_SIGN
                                 &kp RU_CYRILLIC_IO    &layer_en           &trans              &trans              &trans    &trans  &trans              &trans                     &kp RU_COMMA         &kp RU_DOT
            >;
        };

        num-sym-en {
            display-name = "num_sym";
            bindings = <
&none    &kp N1    &kp N2     &kp N3     &kp N4      &kp N5                              &kp COLON        &kp ASTERISK   &kp LPAR          &kp RPAR           &kp EQUAL      &kp NUBS
&kp TAB  &kp N6    &kp N7     &kp N8     &kp N9      &kp N0                              &kp EXCLAMATION  &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMICOLON  &kp APOSTROPHE
&none    &kp HASH  &kp AT     &kp CARET  &kp DOLLAR  &kp PERCENT                         &kp MINUS        &kp AMPERSAND  &kp UNDERSCORE    &kp PIPE           &kp QUESTION   &kp FSLH
                   &kp GRAVE  &kp TILDE  &trans      &ltk 6 SPACE  &kp ESC    &kp ENTER  &trans           &trans         &kp COMMA         &kp DOT
            >;
        };

        num-sym-ru {
            display-name = "num-sym";
            bindings = <
&trans  &trans    &trans     &trans     &trans      &trans                            &kp RU_COLON        &kp ASTERISK   &kp LPAR          &kp RPAR           &kp RU_EQUAL      &kp RU_BACKSLASH
&trans  &trans    &trans     &trans     &trans      &trans                            &kp RU_EXCLAMATION  &kp PLUS       &en LEFT_BRACKET  &en RIGHT_BRACKET  &kp RU_SEMICOLON  &en APOSTROPHE
&trans  &en HASH  &en AT     &en CARET  &en DOLLAR  &kp RU_PERCENT                    &kp RU_MINUS        &en AMPERSAND  &kp UNDERSCORE    &en PIPE           &kp RU_QUESTION   &kp RU_SLASH
                  &en GRAVE  &en TILDE  &trans      &trans          &trans    &trans  &trans              &trans         &kp RU_COMMA      &kp RU_DOT
            >;
        };

        edit {
            display-name = "edit";
            bindings = <
&none  &none  &none  &none  &none  &none                      &kp PAGE_UP    &kp LS(LA(LEFT))  &kp LS(UP)     &kp LS(LA(RIGHT))  &kp LS(HOME)  &none
&none  &none  &none  &none  &none  &none                      &kp PAGE_DOWN  &kp LS(LEFT)      &kp LS(DOWN)   &kp LS(RIGHT)      &kp LS(END)   &none
&none  &none  &none  &none  &none  &none                      &none          &kp BACKSPACE     &kp LC(ENTER)  &kp DELETE         &none         &none
              &none  &none  &none  &none  &none    &kp ENTER  &kp SPACE      &none             &none          &none
            >;
        };

        fn-nav-en {
            display-name = "fn_nav";
            bindings = <
&kp ESC  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                         &kp PAGE_UP    &kp LA(LEFT)   &kp UP          &kp LA(RIGHT)    &kp HOME  &none
&kp TAB  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10                        &kp PAGE_DOWN  &kp LEFT       &kp DOWN        &kp RIGHT        &kp END   &kp DOUBLE_QUOTES
&none    &kp F11  &kp F12  &kp F13  &kp F14  &kp F15                        &cmd_f15 F     &kp BACKSPACE  &kp LG(ENTER)   &kp DELETE       &none     &none
                  &kp LT   &kp GT   &none    &none    &kp ESC    &kp ENTER  &ltk 3 SPACE   &none          &kp LEFT_BRACE  &kp RIGHT_BRACE
            >;
        };

        fn-nav-ru {
            display-name = "fn-nav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans          &trans           &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans          &trans           &trans  &kp RU_DOUBLE_QUOTES
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans          &trans           &trans  &kp RU_NUMERO
                &en LT  &en GT  &trans  &trans  &trans    &trans  &trans  &trans  &en LEFT_BRACE  &en RIGHT_BRACE
            >;
        };

        utils {
            display-name = "utils";
            bindings = <
&bootloader   &cmd_f15 F1   &cmd_f15 F2   &cmd_f15 F3   &cmd_f15 F4   &cmd_f15 F5                   &kp LG(TAB)    &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT       &kp F24     &kp F23
&out OUT_BLE  &cmd_f15 F6   &cmd_f15 F7   &cmd_f15 F8   &cmd_f15 F9   &cmd_f15 F10                  &none          &none              &none             &none            &none       &out OUT_USB
&bt BT_CLR    &cmd_f15 F11  &cmd_f15 F12  &cmd_f15 F13  &cmd_f15 F14  &cmd_f15 F15                  &kp LG(LS(S))  &kp C_VOLUME_DOWN  &kp C_MUTE        &kp C_VOLUME_UP  &kp INSERT  &bootloader
                            &bt BT_SEL 0  &bt BT_SEL 1  &none         &trans        &none    &none  &trans         &none              &bt BT_SEL 2      &bt BT_SEL 3
            >;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans          &mmv MOVE_UP    &trans           &trans           &tog 9
&trans  &trans  &mkp MCLK  &mkp RCLK  &mkp LCLK  &trans        &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans          &trans          &trans          &trans           &trans           &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &msc SCRL_UP    &msc SCRL_DOWN  &trans          &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        symru {
            if-layers = <3 2>;
            then-layer = <4>;
        };

        fnnavru {
            if-layers = <6 2>;
            then-layer = <7>;
        };

        utils {
            if-layers = <3 6>;
            then-layer = <8>;
        };
    };
};
